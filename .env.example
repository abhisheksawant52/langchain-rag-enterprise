# Application
LCRAG_APP_NAME=langchain-rag-enterprise
LCRAG_ENVIRONMENT=development
LCRAG_LOG_LEVEL=INFO

# LLM / embeddings provider
LCRAG_OPENAI_API_KEY=your-key-here
LCRAG_EMBEDDING_MODEL=text-embedding-3-small
LCRAG_LLM_MODEL=gpt-4o-mini
LCRAG_TEMPERATURE=0.0

# Retrieval / vector store
LCRAG_VECTOR_STORE_URL=http://localhost:6333
LCRAG_TOP_K=4

# Conversation memory
LCRAG_MEMORY_WINDOW=5
