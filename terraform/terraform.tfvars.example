region                     = "us-east-1"
environment                = "dev"
project_name               = "langchain-rag-enterprise"
container_image            = "langchain-rag-enterprise:latest"
vector_store_instance_type = "t3.medium"
vector_store_volume_size   = 50
vpc_id                     = "" # leave empty to use the account default VPC
log_retention_days         = 30
